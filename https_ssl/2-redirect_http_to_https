global
    log /dev/log    local0
    log /dev/log    local1 notice
    chroot /var/lib/haproxy
    maxconn 4096
    user haproxy
    group haproxy
    daemon
    tune.ssl.default-dh-param 2048

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  http-server-close
    option  forwardfor
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend www-http
    bind *:80
    mode http
    redirect scheme https code 301 if !{ ssl_fc }

frontend www-https
    bind *:443 ssl crt /etc/haproxy/certs/haproxy.pem
    mode http
    default_backend web-backend

backend web-backend
    mode http
    balance roundrobin
    option httpchk GET /
    server web-01 32.192.227.92:80 check
    server web-02 3.87.14.177:80 check
